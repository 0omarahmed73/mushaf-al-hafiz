<?xml version="1.0" encoding="utf-8"?>
<!-- The launcher icon of Android 8 and later (feature 009): the night background, the art kept inside the 66 dp safe zone, and
     a one-colour layer for themed icons (Android 13 and later; older versions ignore it). The layers are generated by
     tool/make_app_icons.dart. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background"/>
    <foreground android:drawable="@drawable/ic_launcher_foreground"/>
    <monochrome android:drawable="@drawable/ic_launcher_monochrome"/>
</adaptive-icon>
